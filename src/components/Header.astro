---
---
<header id="main-header" class="header">
  <div class="container header-container">
    <a href="#" class="logo" aria-label="Nexora Consultoria - Página Inicial">
      <span class="logo-title">NEXORA</span>
      <span class="logo-sub">CONSULTORIA</span>
    </a>

    <nav class="nav-desktop" aria-label="Navegação Principal">
      <ul class="nav-list">
        <li><a href="#hero" class="nav-link">Início</a></li>
        <li><a href="#sobre" class="nav-link">Sobre</a></li>
        <li><a href="#solucoes" class="nav-link">Soluções</a></li>
        <li><a href="#processo" class="nav-link">Processo</a></li>
        <li><a href="#resultados" class="nav-link">Resultados</a></li>
        <li><a href="#contato" class="nav-link">Contato</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="https://wa.me/5500000000000?text=Olá,%20gostaria%20de%20agendar%20um%20diagnóstico%20gratuito." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-header">
        Agendar diagnóstico
      </a>
      
      <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menu de navegação" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <nav aria-label="Navegação Mobile">
      <ul class="mobile-nav-list">
        <li><a href="#hero" class="mobile-nav-link">Início</a></li>
        <li><a href="#sobre" class="mobile-nav-link">Sobre</a></li>
        <li><a href="#solucoes" class="mobile-nav-link">Soluções</a></li>
        <li><a href="#processo" class="mobile-nav-link">Processo</a></li>
        <li><a href="#resultados" class="mobile-nav-link">Resultados</a></li>
        <li><a href="#contato" class="mobile-nav-link">Contato</a></li>
      </ul>
      <a href="https://wa.me/5500000000000?text=Olá,%20gostaria%20de%20agendar%20um%20diagnóstico%20gratuito." target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full text-center">
        Agendar diagnóstico
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background-color: rgba(11, 11, 13, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 1000;
    transition: all 0.3s ease;
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    flex-direction: column;
    color: var(--color-white);
  }

  .logo-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: 0.15em;
    line-height: 1;
  }

  .logo-sub {
    font-size: 0.55rem;
    letter-spacing: 0.35em;
    color: var(--color-green-light);
    margin-top: 3px;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    color: var(--color-gray-medium);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-white);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-header {
    padding: 0.6rem 1.25rem;
    font-size: 0.85rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 16px;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background-color: var(--color-white);
    transition: all 0.3s ease;
  }

  .mobile-menu {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100%;
    background-color: var(--color-black);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2rem 1.5rem;
    display: none;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-menu[aria-hidden="false"] {
    display: flex;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .mobile-nav-link {
    color: var(--color-white);
    font-size: 1.125rem;
    font-family: var(--font-heading);
  }

  .w-full { width: 100%; }
  .text-center { text-align: center; }

  @media (max-width: 900px) {
    .nav-desktop, .btn-header { display: none; }
    .menu-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.setAttribute('aria-hidden', isExpanded.toString());
  });

  // Fechar menu ao clicar num link
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
    });
  });
</script>