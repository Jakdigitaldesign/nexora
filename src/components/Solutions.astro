---
const solutions = [
  {
    num: "01",
    title: "Estratégia Empresarial",
    desc: "Planejamento estratégico, definição clara de objetivos e criação de planos de ação mensuráveis."
  },
  {
    num: "02",
    title: "Gestão e Processos",
    desc: "Mapeamento e otimização de processos internos para aumentar a produtividade e eliminar gargalos."
  },
  {
    num: "03",
    title: "Indicadores e Performance",
    desc: "Criação de dashboards e métricas chave para acompanhar resultados e apoiar decisões precisas."
  },
  {
    num: "04",
    title: "Crescimento e Expansão",
    desc: "Estratégias para estruturar operações e preparar a empresa para escalar de forma sustentável."
  }
];
---
<section id="solucoes" class="section-solutions">
  <div class="container">
    <div class="solutions-header reveal">
      <span class="section-tag">03 / SOLUÇÕES</span>
      <h2 class="section-title">Como podemos ajudar sua empresa</h2>
    </div>

    <div class="solutions-list">
      {solutions.map((item) => (
        <a href="https://wa.me/5500000000000?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20a%20solução%20de%20Estratégia." target="_blank" class="solution-item reveal">
          <span class="sol-num">{item.num}</span>
          <div class="sol-content">
            <h3 class="sol-title">{item.title}</h3>
            <p class="sol-desc">{item.desc}</p>
          </div>
          <div class="sol-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section-solutions {
    padding: 7rem 0;
    background-color: var(--color-gray-light);
  }

  .solutions-header {
    margin-bottom: 3.5rem;
  }

  .solutions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .solution-item {
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    align-items: center;
    background: var(--color-white);
    padding: 2.5rem;
    border: 1px solid var(--color-gray-border);
    border-radius: 4px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .solution-item:hover {
    border-color: var(--color-green-dark);
    transform: translateX(6px);
  }

  .sol-num {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-green-dark);
  }

  .sol-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: 0.5rem;
  }

  .sol-desc {
    font-size: 0.95rem;
    color: #666;
    max-width: 650px;
  }

  .sol-arrow {
    color: var(--color-black);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .solution-item:hover .sol-arrow {
    transform: translateX(4px);
    color: var(--color-green-dark);
  }

  @media (max-width: 768px) {
    .solution-item {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.5rem;
    }
    .sol-arrow { display: none; }
  }
</style>